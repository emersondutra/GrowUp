# ====================================================================
# GROWUP INVESTMENT TRACKER - CONFIGURAÇÃO DE AMBIENTE (.env)
# ====================================================================

# Porta da aplicação (padrão 3000)
PORT=3000
NODE_ENV=production

# ====================================================================
# OPÇÃO A: CONEXÃO VIA STRING DE CONEXÃO (DATABASE_URL) - RECOMENDADO PARA VPS
# ====================================================================
# Formato padrão: postgresql://[USUARIO]:[SENHA]@[HOST]:[PORTA]/[BANCO]
# Exemplos:
# Local/VPS Docker: postgresql://growup_user:growup_secret_pass@localhost:5432/growup
# Docker Compose: postgresql://growup_user:growup_secret_pass@postgres:5432/growup
# Supabase Pooler: postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://growup_user:growup_secret_pass@localhost:5432/growup"

# ====================================================================
# OPÇÃO B: CONEXÃO VIA VARIÁVEIS SEPARADAS (Caso não use DATABASE_URL)
# ====================================================================
# Host do PostgreSQL (localhost se rodar na mesma VPS, ou IP/domínio)
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="growup"
PGUSER="growup_user"
PGPASSWORD="growup_secret_pass"

# Usuário administrativo para migrações Drizzle (pode ser o mesmo ou superuser)
SQL_ADMIN_USER="growup_user"
SQL_ADMIN_PASSWORD="growup_secret_pass"

# Configuração SSL para o banco de dados:
# "false" -> Conexões locais ou Docker dentro da VPS (recomendado)
# "true" ou "require" -> Managed PostgreSQL na nuvem (Supabase, Neon, RDS)
DB_SSL="false"

# Pool de conexões (máximo de clientes simultâneos)
DB_POOL_MAX="10"

# ====================================================================
# SUPABASE / FIREBASE / APIS OPCIONAIS
# ====================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GEMINI_API_KEY: Opcional para recursos de inteligência artificial
GEMINI_API_KEY=""
APP_URL="http://seu-dominio-ou-ip:3000"
